{
	"permissions": {
		"allow": [
			"Bash(npx biome:*)",
			"Bash(npm run build:*)",
			"Bash(npm run format:*)",
			"Bash(npm run lint:*)",
			"Bash(npm run lint:fix:*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "npm run lint:fix && npm run format"
					}
				]
			}
		]
	}
}

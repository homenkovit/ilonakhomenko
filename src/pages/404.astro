---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<div class="not-found">
		<h1 class="page-title">Как так? Нет такой страницы</h1>
		<video
			class="not-found__video"
			autoplay
			loop
			muted
			playsinline
			poster="/images/confused-travolta.webp"
		>
			<source src="/images/confused-travolta.mp4" type="video/mp4">
		</video>
	</div>
</BaseLayout>

<style>
.not-found {
	padding-inline: 24px;
	text-align: center;
}

.not-found__video {
	max-width: 800px;
	width: 100%;
	border-radius: 28px;
}
</style>

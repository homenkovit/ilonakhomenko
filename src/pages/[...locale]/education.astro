---
import type { ImageMetadata } from "astro";
import CertificateCarousel from "../../components/shared/CertificateCarousel.astro";
import { certificates as certificateList, educationContent } from "../../data/pages";
import type { Lang } from "../../i18n/utils";
import { getLocaleStaticPaths, useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = getLocaleStaticPaths;

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = educationContent[lang];

const educationImages = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/images/education/*.webp",
	{ eager: true },
);

function resolveEducationImage(file: string): ImageMetadata {
	const path = `../../assets/images/education/${file}.webp`;
	const module = educationImages[path];

	if (!module) {
		throw new Error(
			`education.astro: no image found for "${file}" (expected ${path}). ` +
				`Check src/data/pages/education.ts and src/assets/images/education/ are in sync.`,
		);
	}

	return module.default;
}

const certificates = certificateList.map(({ file, alt }) => ({
	src: resolveEducationImage(file),
	alt: alt[lang],
}));
---

<BaseLayout
	title={t("page.education.title")}
	description={t("page.education.description")}
	class="container"
	lang={lang}
>
	<section class="page-section">
		<h1 class="page-title">{content.pageTitle}</h1>
		{content.introParagraphs.map((paragraph) => <p class="page-text" set:html={paragraph} />)}
	</section>
	<section class="page-section">
		<h2 class="page-subtitle">{content.certsTitle}</h2>
		<CertificateCarousel images={certificates} lang={lang} />
	</section>
</BaseLayout>

---
import { bookingContent } from "../../data/pages";
import type { Lang } from "../../i18n/utils";
import { getLocaleStaticPaths, useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = getLocaleStaticPaths;

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = bookingContent[lang];
---

<BaseLayout
	title={t("page.booking.title")}
	description={t("page.booking.description")}
	class="container"
	lang={lang}
>
	<section class="page-section">
		<h2 class="page-title">{content.title}</h2>
		<p class="page-text">{content.subtitle}</p>
		<div id="booking-offline" class="booking-offline" hidden>
			<p>{content.offlineMessage}</p>
		</div>
		<div
			id="booking-loading"
			class="booking-loading"
			hidden
			aria-label={t("booking.loading")}
			aria-live="polite"
		>
			<div class="booking-spinner"></div>
		</div>
		<div id="cal-embed" class="cal-embed"></div>
	</section>
</BaseLayout>

<style>
.page-text {
	text-align: center;
	margin-block-end: 60px;

	@media screen and (width < 768px) {
		margin-block-end: 32px;
	}
}

.booking-offline {
	text-align: center;
	padding: 40px 24px;
	border-radius: var(--radius-lg);
	background-color: var(--surface-light-color);
	font-size: 20px;
	line-height: 30px;
}

.booking-loading {
	justify-content: center;
	align-items: center;
	padding: 80px 0;

	&:not([hidden]) {
		display: flex;
	}
}

.booking-spinner {
	width: 48px;
	height: 48px;
	border: 4px solid var(--surface-light-color);
	border-top-color: var(--text-color);
	border-radius: 50%;
	animation: spin 0.8s linear infinite;
}

@keyframes spin {
	to {
		transform: rotate(360deg);
	}
}
</style>

<style is:global>
.cal-embed {
	border: none;
}
</style>

<script>
import { initCalInlineWidget } from "../../scripts/cal-embed";

let iframeObserver: MutationObserver | null = null;

function showLoading() {
	const loading = document.getElementById("booking-loading");
	if (loading) loading.hidden = false;
}

function hideLoading() {
	iframeObserver?.disconnect();
	iframeObserver = null;
	const loading = document.getElementById("booking-loading");
	if (loading) loading.hidden = true;
}

function showOffline() {
	hideLoading();
	const notice = document.getElementById("booking-offline");
	const embed = document.getElementById("cal-embed");
	if (notice) notice.hidden = false;
	if (embed) embed.hidden = true;
}

function watchForIframe(embed: HTMLElement) {
	iframeObserver = new MutationObserver(() => {
		if (embed.querySelector("iframe")) {
			hideLoading();
		}
	});
	iframeObserver.observe(embed, { childList: true, subtree: true });
}

function tryLoadWidget() {
	const notice = document.getElementById("booking-offline");
	const embed = document.getElementById("cal-embed");
	if (!embed) return;

	if (!navigator.onLine) {
		showOffline();
		return;
	}

	if (notice) notice.hidden = true;
	embed.hidden = false;
	showLoading();
	watchForIframe(embed);
	initCalInlineWidget("#cal-embed");
}

tryLoadWidget();
window.addEventListener("cal-embed-error", showOffline);
window.addEventListener("online", tryLoadWidget);
window.addEventListener("offline", showOffline);
</script>

---
import ContactLinks from "./ContactLinks.astro";
import Icon from "./Icon.astro";
---

<dialog
	id="appointment-dialog"
	class="appointment-dialog"
	aria-labelledby="appointment-title"
	closedby="any"
>
	<button type="button" class="close-button" aria-label="Закрыть">
		<Icon name="close" size={44} />
	</button>
	<h2 id="appointment-title" class="title">Запись на консультацию</h2>
	<a href="/booking" class="booking-link">
		<span>Выбрать дату и время</span>
		<Icon name="calendar" size={24} />
	</a>
	<p class="divider">Или напишите мне:</p>
	<ContactLinks />
</dialog>

<style>
.appointment-dialog {
	overflow: hidden;
	box-sizing: border-box;
	width: 100%;
	max-width: 484px;
	height: 530px;
	padding: 24px;
	border: none;
	border-radius: 4px;
	background-color: #ddc0e3;

	&::backdrop {
		background-color: rgb(0 0 0 / 50%);
	}

	.contact-links {
		flex-direction: column;
		gap: 16px;

		svg {
			width: 36px;
			height: 36px;
		}
	}
}

.close-button {
	display: flex;
	padding: 0;
	border: none;
	margin-block-end: 4px;
	margin-inline-start: auto;
	background-color: transparent;
	color: inherit;
	cursor: pointer;
}

.title {
	margin-block-start: 0;
	margin-block-end: 32px;
	font-size: 40px;
	line-height: 100%;
	font-weight: 400;
}

.booking-link {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12px;
	box-sizing: border-box;
	width: 100%;
	padding: 10px;
	border: none;
	border-radius: 50px;
	background-color: var(--primary-color);
	color: var(--secondary-color);
	font-size: 24px;
	line-height: 32px;
	text-decoration: none;
	cursor: pointer;
	transition: background-color 0.2s;

	&:hover {
		background-color: var(--hover-color);
	}

	&:visited {
		color: #ffffff;
	}
}

.divider {
	margin-block: 24px;
	font-size: 18px;
	text-align: center;
}
</style>

<script>
document.addEventListener(
	"close",
	(event) => {
		if (event.target instanceof Element && event.target.id === "appointment-dialog") {
			document.body.style.overflow = "auto";
		}
	},
	true,
);

document.addEventListener("click", (event) => {
	if (
		event.target instanceof Element &&
		event.target.closest("#appointment-dialog .close-button")
	) {
		const dialog = document.querySelector<HTMLDialogElement>("#appointment-dialog");
		dialog?.close();
	}
});
</script>

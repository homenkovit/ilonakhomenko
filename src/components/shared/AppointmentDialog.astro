---
import type { Lang } from "../../i18n/utils";
import { getLocalizedPath, useTranslations } from "../../i18n/utils";
import ContactLinks from "./ContactLinks.astro";
import Icon from "./Icon.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const bookingHref = getLocalizedPath("/booking", lang);
---

<dialog
	id="appointment-dialog"
	class="appointment-dialog"
	aria-labelledby="appointment-title"
	closedby="any"
>
	<button type="button" class="close-button" aria-label={t("dialog.appointment.close")}>
		<Icon name="close" size={44} />
	</button>
	<h2 id="appointment-title" class="title">{t("dialog.appointment.title")}</h2>
	<a href={bookingHref} class="booking-link">
		<span>{t("dialog.appointment.pickDate")}</span>
		<Icon name="calendar" size={24} />
	</a>
	<p class="divider">{t("dialog.appointment.divider")}</p>
	<ContactLinks />
</dialog>

<style>
.appointment-dialog {
	overflow: hidden;
	box-sizing: border-box;
	width: 100%;
	max-width: 484px;
	height: 530px;
	padding: 24px;
	border: none;
	border-radius: var(--radius-sm);
	background-color: var(--surface-color);

	&::backdrop {
		background-color: var(--backdrop-color);
	}

	.contact-links {
		flex-direction: column;
		gap: 16px;

		svg {
			width: 36px;
			height: 36px;
		}
	}
}

.close-button {
	display: flex;
	padding: 0;
	border: none;
	margin-block-end: 4px;
	margin-inline-start: auto;
	background-color: transparent;
	color: inherit;
	cursor: pointer;
}

.title {
	margin-block-start: 0;
	margin-block-end: 32px;
	font-size: 40px;
	line-height: 100%;
	font-weight: 400;
}

.booking-link {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12px;
	box-sizing: border-box;
	width: 100%;
	padding: 10px;
	border: none;
	border-radius: var(--radius-full);
	background-color: var(--text-color);
	color: var(--bg-color);
	font-size: 24px;
	line-height: 32px;
	text-decoration: none;
	cursor: pointer;
	transition: background-color var(--transition-fast);

	&:hover {
		background-color: var(--hover-color);
	}

	&:visited {
		color: var(--bg-color);
	}
}

.divider {
	margin-block: 24px;
	font-size: 18px;
	text-align: center;
}
</style>

<script>
document.addEventListener(
	"close",
	(event) => {
		if (event.target instanceof Element && event.target.id === "appointment-dialog") {
			document.body.style.overflow = "auto";
		}
	},
	true,
);

document.addEventListener("click", (event) => {
	if (
		event.target instanceof Element &&
		event.target.closest("#appointment-dialog .close-button")
	) {
		const dialog = document.querySelector<HTMLDialogElement>("#appointment-dialog");
		dialog?.close();
	}
});
</script>

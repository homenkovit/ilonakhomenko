---
import type { Lang } from "../../i18n/utils";
import { getLocalizedPath, useTranslations } from "../../i18n/utils";
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { pathname } = Astro.url;

const normalizePathname = (path: string) => path.replace(/\/$/, "") || "/";
const getIsLinkActive = (href: string) =>
	!href.includes("#") && normalizePathname(pathname) === normalizePathname(href);

const navigationLinks = [
	{ href: getLocalizedPath("/", lang), label: t("nav.home") },
	{ href: getLocalizedPath("/help", lang), label: t("nav.help") },
	{ href: getLocalizedPath("/price", lang), label: t("nav.price") },
	{ href: getLocalizedPath("/faq", lang), label: t("nav.faq") },
	{ href: getLocalizedPath("/about", lang), label: t("nav.about") },
	{ href: getLocalizedPath("/articles", lang), label: t("nav.articles") },
	{ href: getLocalizedPath("/tests", lang), label: t("nav.tests") },
	{ href: getLocalizedPath("/education", lang), label: t("nav.education") },
];
---

<button
	type="button"
	class="menu-button"
	aria-label={t("nav.aria.menuButton")}
	aria-expanded="false"
	aria-controls="menu"
>
	<span>{t("nav.menuButton")}</span>
	<Icon name="menu" />
</button>
<nav id="menu" class="menu closed" aria-label={t("nav.aria.menu")}>
	<ul class="nav-list">
		{navigationLinks.map((link) => {
			const isActive = getIsLinkActive(link.href);

			return (
				<li class="nav-item">
					<a
						href={link.href}
						class:list={["nav-link", { active: isActive }]}
						aria-current={isActive ? "page" : undefined}
					>
						{link.label}
					</a>
				</li>
			);
		})}
	</ul>
	<div class="menu-theme-switcher">
		<LanguageSwitcher lang={lang} pathname={pathname} />
		<ThemeSwitcher lang={lang} />
	</div>
</nav>

<style>
.menu-button {
	display: flex;
	align-items: center;
	gap: 12px;
	padding: 0;
	border: none;
	margin: 0;
	background-color: transparent;
	cursor: pointer;
	font-size: 24px;
	line-height: 30px;
	color: var(--text-color);
	text-transform: uppercase;

	@media (prefers-reduced-motion: no-preference) {
		transition: color var(--transition-fast);
	}

	@media (hover: hover) {
		&:hover {
			color: var(--hover-color);
		}
	}

	&:active,
	&[aria-expanded="true"] {
		color: var(--hover-color);
	}

	@media screen and (width >= 1138px) {
		display: none;
	}

	@media screen and (width < 800px) {
		font-size: 18px;
		line-height: 24px;
	}

	@media screen and (width < 600px) {
		span {
			display: none;
		}
	}
}

.menu {
	@media screen and (width < 1138px) {
		z-index: 1;
		position: fixed;
		inset: var(--header-height) 0 0;
		box-sizing: border-box;
		contain: layout;
		overflow-y: auto;
		padding: 20px;
		padding-block-end: 0;
		border-top: 2px solid var(--border-color);
		background-color: var(--bg-color);

		@media (prefers-reduced-motion: no-preference) {
			transition:
				opacity 0.3s ease,
				transform 0.3s ease,
				display 0.3s ease allow-discrete;

			@starting-style {
				opacity: 0;
				transform: translateX(100%);
			}
		}

		&.closed {
			display: none;
			opacity: 0;
			transform: translateX(100%);
		}

		.nav-list {
			flex-direction: column;
			align-items: stretch;
			gap: 20px;
		}

		.nav-item {
			display: flex;
			justify-content: center;
			width: 100%;
		}

		.nav-link {
			box-sizing: border-box;
			width: 100%;
			max-width: 462px;
			padding: 20px;
			font-size: 22px;
			line-height: 30px;
			text-align: center;
		}
	}
}

.menu-theme-switcher {
	position: sticky;
	bottom: 0;
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 16px;
	padding-block: 16px;
	padding-inline: 20px;
	margin-block-start: 20px;
	margin-inline: -20px;
	border-top: 1px solid var(--border-color);
	background-color: var(--bg-color);

	@media screen and (width >= 1138px) {
		display: none;
	}
}

.nav-list {
	display: flex;
	align-items: center;
	list-style: none;
	padding: 0;
	margin: 0;
}

.nav-link {
	display: block;
	padding: 8px 24px;
	font-size: 18px;
	line-height: 28px;
	color: var(--text-color);
	white-space: nowrap;
	text-decoration: none;

	@media (prefers-reduced-motion: no-preference) {
		transition: color var(--transition-fast);
	}

	&:hover,
	&:active {
		color: var(--hover-color);
	}

	&:hover,
	&:active,
	&.active {
		text-decoration: underline;
	}
}
</style>

<script>
function getElements() {
	return {
		main: document.querySelector("main"),
		footer: document.querySelector("footer"),
		menuButton: document.querySelector<HTMLButtonElement>(".menu-button"),
		menu: document.querySelector<HTMLElement>(".menu"),
	};
}

function isMenuOpened(): boolean {
	const { menuButton } = getElements();
	return menuButton?.getAttribute("aria-expanded") === "true";
}

function openMenu() {
	const { main, footer, menuButton, menu } = getElements();
	document.body.style.overflow = "hidden";
	main?.setAttribute("inert", "");
	footer?.setAttribute("inert", "");
	menuButton?.setAttribute("aria-expanded", "true");
	menu?.classList.remove("closed");
}

function closeMenu() {
	const { main, footer, menuButton, menu } = getElements();
	document.body.style.overflow = "auto";
	main?.removeAttribute("inert");
	footer?.removeAttribute("inert");
	menuButton?.setAttribute("aria-expanded", "false");
	menu?.classList.add("closed");
}

document.addEventListener("click", (event) => {
	if (event.target instanceof Element && event.target.closest(".menu-button")) {
		isMenuOpened() ? closeMenu() : openMenu();
	}
});

document.addEventListener("keyup", (event: KeyboardEvent) => {
	if (event.key === "Escape" && isMenuOpened()) {
		closeMenu();
	}
});
</script>

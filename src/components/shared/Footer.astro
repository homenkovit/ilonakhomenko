---
import type { Lang } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";
import ContactLinks from "./ContactLinks.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="footer container">
	<ContactLinks />
	<p class="info-text">{t("footer.disclaimer")}</p>
</footer>

<style>
.footer {
	padding-block: 50px;
	background-color: light-dark(var(--accent-color), var(--bg-color));
	color: light-dark(var(--bg-color), var(--text-color));

	&.container {
		--container-width: 1592px;
	}
}

.info-text {
	margin-block-start: 28px;
	margin-block-end: 0;
	font-size: 18px;
	line-height: 24px;
}
</style>

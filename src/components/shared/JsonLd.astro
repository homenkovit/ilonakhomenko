---
import type { Lang } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";

interface ArticleData {
	title: string;
	description: string;
	datePublished: string;
	url: string;
}

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface Props {
	type: "ProfessionalService" | "Article" | "WebPage";
	articleData?: ArticleData;
	breadcrumbs?: BreadcrumbItem[];
	lang: Lang;
	pageUrl?: string;
}

const { type, articleData, breadcrumbs, lang, pageUrl } = Astro.props;
const t = useTranslations(lang);
const siteUrl = import.meta.env.SITE;

const psychologistSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"@id": `${siteUrl}/#psychologist`,
	name: t("site.title"),
	url: siteUrl,
	description: t("jsonld.description"),
	inLanguage: lang,
	priceRange: "€60",
	areaServed: {
		"@type": "Place",
		name: t("jsonld.areaServed"),
	},
	provider: {
		"@type": "Person",
		name: t("jsonld.personName"),
		jobTitle: t("jsonld.jobTitle"),
		url: siteUrl,
	},
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: t("jsonld.serviceCatalog"),
		itemListElement: [
			{
				"@type": "Offer",
				itemOffered: {
					"@type": "Service",
					name: t("jsonld.serviceName"),
				},
			},
		],
	},
};

const articleSchema = articleData
	? {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: articleData.title,
			description: articleData.description,
			datePublished: articleData.datePublished,
			url: articleData.url,
			inLanguage: lang,
			author: {
				"@type": "Person",
				name: t("jsonld.personName"),
			},
			publisher: {
				"@type": "Organization",
				name: t("site.title"),
				url: siteUrl,
			},
		}
	: null;

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	url: pageUrl || siteUrl,
	name: t("site.title"),
	inLanguage: lang,
	isPartOf: {
		"@type": "WebSite",
		url: siteUrl,
		name: t("site.title"),
	},
};

const schema =
	type === "Article" && articleSchema
		? articleSchema
		: type === "ProfessionalService"
			? psychologistSchema
			: webPageSchema;

const breadcrumbSchema = breadcrumbs
	? {
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: breadcrumbs.map((item, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: item.name,
				item: item.url,
			})),
		}
	: null;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
{breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

---
import { homeHelpContent } from "../../data/pages";
import type { Lang } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";

interface Props {
	titleTag?: "h1" | "h2";
	lang: Lang;
}

const { titleTag: TitleTag = "h2", lang } = Astro.props;
const t = useTranslations(lang);
const content = homeHelpContent[lang];
---

<section class="help container">
	<TitleTag class="page-subtitle">{t("section.help.title")}</TitleTag>
	<ol class="help__list">
		{content.topics.map((topic) => (
			<li class="help__item">
				<h3 class="help__item-title">{topic.title}</h3>
				<ul class="item-list">
					{topic.items.map((item) => (
						<li class="item-list__item">{item}</li>
					))}
				</ul>
			</li>
		))}
	</ol>

	<p class="info-text">{content.disclaimer}</p>
</section>

<style>
.help {
	&.container {
		--container-width: 1592px;

		@media screen and (width < 1240px) {
			--container-width: 704px;
		}
	}
}

.help__list {
	counter-reset: list;
	list-style: none;
	display: grid;
	grid-template-columns: 1fr 1fr;
	column-gap: 196px;
	row-gap: 70px;
	padding-inline-start: 96px;
	margin-block: 0;

	@media screen and (width < 1240px) {
		grid-template-columns: 1fr;
		row-gap: 40px;
	}

	@media screen and (width < 600px) {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		display: flex;
		gap: 0;
		max-width: 100%;
		padding-inline: 24px;
		padding-block-start: 4px;
		margin-inline: -24px;
		margin-block-start: -4px;

		.help__item {
			min-width: 100%;
			scroll-snap-align: center;
			scroll-snap-stop: always;
		}
	}
}

.help__item-title {
	counter-increment: list;
	display: flex;
	align-items: center;
	gap: 24px;
	margin-block-start: 0;
	margin-block-end: 16px;
	font-size: 24px;
	line-height: 34px;
	font-weight: 600;
	transform: translateX(-96px);

	&::before {
		content: counter(list);
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background-color: var(--accent-color);
		font-size: 33px;
		line-height: 30px;
		font-weight: 400;
		color: var(--bg-color);
	}

	@media screen and (width < 600px) {
		align-items: flex-start;
		gap: 16px;
		transform: translateX(0);

		&::before {
			width: 40px;
			height: 40px;
			margin-top: -4px;
			font-size: 20px;
			line-height: 30px;
		}
	}
}

.item-list {
	list-style-type: disc;
}

.item-list__item {
	font-size: 20px;
	line-height: 30px;
}

.info-text {
	margin-block-start: 60px;
	margin-block-end: 0;
	font-size: 18px;
}
</style>

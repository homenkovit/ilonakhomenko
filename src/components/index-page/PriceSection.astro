---
import { homePriceContent } from "../../data/pages";
import type { Lang } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";
import AppointmentButton from "../shared/AppointmentButton.astro";
import ContactLinks from "../shared/ContactLinks.astro";
import Icon from "../shared/Icon.astro";

interface Props {
	titleTag?: "h1" | "h2";
	lang: Lang;
}

const { titleTag: TitleTag = "h2", lang } = Astro.props;
const t = useTranslations(lang);
const content = homePriceContent[lang];
---

<section class="price container">
	<TitleTag class="page-subtitle">{t("section.price.title")}</TitleTag>
	<ul class="price__list">
		<li class="price__item">
			<h3 class="price__item-title">{content.cardTitle}</h3>
			<ul class="item-list">
				{content.features.map((feature) => (
					<li class="item-list__item">
						<Icon name="check" size={30} />
						{feature}
					</li>
				))}
			</ul>
			<p class="item-price">{content.price}</p>
			<AppointmentButton lang={lang} />
		</li>
	</ul>
	<p class="price__text">{content.infoText}</p>
	<p class="price__contact-text">{content.contactText}</p>
	<ContactLinks />
</section>

<style>
.price {
	display: flex;
	flex-direction: column;
	align-items: center;

	&.container {
		--container-width: 1592px;
	}

	.contact-links {
		color: var(--accent-color);

		@media screen and (width < 768px) {
			align-items: center;
		}
	}
}

.price__list {
	list-style: none;
	display: flex;
	justify-content: center;
	flex-wrap: wrap;
	padding-inline: 0;
	margin-block-start: 0;
	margin-block-end: 108px;

	@media screen and (width < 1500px) {
		margin-block-end: 88px;
	}

	@media screen and (width < 768px) {
		margin-block-end: 48px;
	}
}

.price__item {
	display: flex;
	flex-direction: column;
	align-items: center;
	box-sizing: border-box;
	max-width: 518px;
	padding: 32px 36px;
	border: 4px solid var(--border-color);
	border-radius: var(--radius-lg);
	background-color: var(--bg-color);
}

.price__item-title {
	margin-block-start: 0;
	margin-block-end: 60px;
	font-size: 40px;
	line-height: 50px;
	text-align: center;

	@media screen and (width < 1500px) {
		font-size: 30px;
		line-height: 40px;
	}

	@media screen and (width < 768px) {
		margin-block-end: 32px;
		font-size: 24px;
		line-height: 30px;
	}
}

.item-list {
	align-self: flex-start;
	display: flex;
	flex-direction: column;
	gap: 20px;
	padding-inline-start: 0;
	margin-block-start: 0;
	margin-block-end: 40px;
}

.item-list__item {
	display: flex;
	align-items: flex-start;
	gap: 12px;
	font-size: 20px;
	line-height: 30px;
	list-style: none;

	svg {
		flex-shrink: 0;
	}
}

.item-price {
	margin-block-start: 0;
	margin-block-end: 32px;
	font-size: 50px;
	line-height: 60px;
	font-weight: 700;
}

.price__text {
	max-width: 720px;
	margin-block-start: 0;
	margin-block-end: 44px;
	font-size: 20px;
	line-height: 30px;
	text-align: center;
}

.price__contact-text {
	margin-block-start: 0;
	margin-block-end: 20px;
	font-size: 20px;
	line-height: 30px;
}
</style>

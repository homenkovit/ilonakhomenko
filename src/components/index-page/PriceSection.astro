---
import AppointmentButton from "../shared/AppointmentButton.astro";
import ContactLinks from "../shared/ContactLinks.astro";
import Icon from "../shared/Icon.astro";

interface Props {
	titleTag?: "h1" | "h2";
}

const { titleTag: TitleTag = "h2" } = Astro.props;
---

<section class="price container">
	<TitleTag class="page-subtitle">Стоимость и формат работы</TitleTag>
	<ul class="price__list">
		<li class="price__item">
			<h3 class="price__item-title">Онлайн консультация</h3>
			<ul class="item-list">
				<li class="item-list__item">
					<Icon name="check" size={30} />
					Встреча длится 60 минут
				</li>
				<li class="item-list__item">
					<Icon name="check" size={30} />
					Отвечу на интересующие вас вопросы
				</li>
				<li class="item-list__item">
					<Icon name="check" size={30} />
					Соберу основную информацию
				</li>
				<li class="item-list__item">
					<Icon name="check" size={30} />
					Всё, что для этого нужно - стабильное интернет-соединение и помещение, где вас не будут
					отвлекать
				</li>
			</ul>
			<p class="item-price">€50 / $55</p>
			<AppointmentButton />
		</li>
	</ul>
	<p class="price__text">
		Работаю только онлайн, по всему миру, по предоплате. Оплату принимаю в евро и долларах. Буду
		рада вам помочь!
	</p>
	<p class="price__contact-text">Для связи:</p>
	<ContactLinks />
</section>

<style>
.price {
	display: flex;
	flex-direction: column;
	align-items: center;

	&.container {
		--container-width: 1592px;
	}

	.contact-links {
		color: var(--accent-color);

		@media screen and (width < 768px) {
			align-items: center;
		}
	}
}

.price__list {
	list-style: none;
	display: flex;
	justify-content: center;
	flex-wrap: wrap;
	padding-inline: 0;
	margin-block-start: 0;
	margin-block-end: 108px;

	@media screen and (width < 1500px) {
		margin-block-end: 88px;
	}

	@media screen and (width < 768px) {
		margin-block-end: 48px;
	}
}

.price__item {
	display: flex;
	flex-direction: column;
	align-items: center;
	box-sizing: border-box;
	max-width: 518px;
	padding: 32px 36px;
	border: 4px solid var(--border-color);
	border-radius: var(--radius-lg);
	background-color: var(--bg-color);
}

.price__item-title {
	margin-block-start: 0;
	margin-block-end: 60px;
	font-size: 40px;
	line-height: 50px;
	text-align: center;

	@media screen and (width < 1500px) {
		font-size: 30px;
		line-height: 40px;
	}

	@media screen and (width < 768px) {
		margin-block-end: 32px;
		font-size: 24px;
		line-height: 30px;
	}
}

.item-list {
	align-self: flex-start;
	display: flex;
	flex-direction: column;
	gap: 20px;
	padding-inline-start: 0;
	margin-block-start: 0;
	margin-block-end: 40px;
}

.item-list__item {
	display: flex;
	align-items: flex-start;
	gap: 12px;
	font-size: 20px;
	line-height: 30px;
	list-style: none;

	svg {
		flex-shrink: 0;
	}
}

.item-price {
	margin-block-start: 0;
	margin-block-end: 32px;
	font-size: 50px;
	line-height: 60px;
	font-weight: 700;
}

.price__text {
	max-width: 720px;
	margin-block-start: 0;
	margin-block-end: 44px;
	font-size: 20px;
	line-height: 30px;
	text-align: center;
}

.price__contact-text {
	margin-block-start: 0;
	margin-block-end: 20px;
	font-size: 20px;
	line-height: 30px;
}
</style>

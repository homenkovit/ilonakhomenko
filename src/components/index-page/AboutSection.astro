---
import { Image } from "astro:assets";
import myPhoto from "../../assets/images/my-photo.webp";
import { homeAboutContent } from "../../data/pages";
import type { Lang } from "../../i18n/utils";
import { getLocalizedPath } from "../../i18n/utils";
import AppointmentButton from "../shared/AppointmentButton.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const content = homeAboutContent[lang];
const aboutHref = getLocalizedPath("/about", lang);
---

<section class="about container">
	<h1 class="about__title page-title">{content.title}</h1>
	{content.paragraphs.map((p) => <p class="about__text" set:html={p}></p>)}
	<div class="about__photo">
		<Image src={myPhoto} alt={content.photoAlt} width={536} height={728} />
	</div>
	<div class="about__buttons">
		<AppointmentButton lang={lang} />
		<a href={aboutHref} class="about__link">{content.learnMoreText}</a>
	</div>
</section>

<style>
.about {
	display: grid;
	grid-template-columns: 1fr 35%;
	column-gap: 158px;

	&.container {
		--container-width: 1592px;
	}

	@media screen and (width < 1500px) {
		display: flex;
		flex-direction: column;

		&.container {
			--container-width: 882px;
		}
	}
}

.about__title {
	grid-column: 1 / 2;

	@media screen and (width >= 1500px) {
		text-align: left;
	}
}

.about__text {
	grid-column: 1 / 2;
	margin-block-start: 0;
	font-size: 20px;
	line-height: 30px;

	@media screen and (width >= 1500px) {
		margin-block-end: 40px;
	}
}

.about__photo {
	grid-column: 2 / 2;
	grid-row: 1 / 5;
	align-self: center;
	display: flex;
	justify-content: flex-end;
	align-items: center;

	img {
		width: 100%;
		max-width: 536px;
		object-fit: contain;
	}

	@media screen and (width < 1500px) {
		overflow: hidden;
		width: 500px;
		height: 500px;
		border-radius: 50%;
		margin-block: 60px;

		img {
			object-position: 0 80px;
		}
	}

	@media screen and (width < 768px) {
		width: 300px;
		height: 300px;
		margin-block: 40px;

		img {
			object-position: 0 200px;
		}
	}
}

.about__buttons {
	grid-column: 1 / 2;
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 24px;

	@media screen and (width < 1500px) {
		align-self: center;
		justify-content: center;
	}
}

.about__link {
	font-size: 24px;
	line-height: 32px;
	text-transform: uppercase;
	color: var(--text-color);

	@media (prefers-reduced-motion: no-preference) {
		transition: color var(--transition-fast);
	}

	@media (hover: hover) {
		&:hover {
			color: var(--hover-color);
		}
	}

	&:active {
		color: var(--hover-color);
	}
}
</style>

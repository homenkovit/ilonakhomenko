---
import { getCollection } from "astro:content";
import type { Lang } from "../../i18n/utils";
import { getLocalizedPath, useTranslations } from "../../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const testsPath = getLocalizedPath("/tests", lang);

const collectionName = lang === "en" ? "testsEn" : "testsRu";
const tests = await getCollection(collectionName);
---

<section class="tests container">
	<h2 class="page-subtitle">{t("section.tests.title")}</h2>
	<ul class="tests__list">
		{tests.map((test) => (
			<li class="tests__item">
				<a href={`${testsPath}/${test.id}`} class="test-link">
					<h3 class="test-link__title">{test.data.title}</h3>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
.tests {
	overflow: hidden;
	position: relative;
	background-repeat: no-repeat;

	&.container {
		--container-width: 1592px;
	}

	@media screen and (width >= 1500px) {
		min-height: 1200px;
		background-image: url("/images/tests-section-cover.webp");
		background-position: 100% 290px;
		background-size: 603px 752px;
	}

	@media screen and (width < 1500px) {
		padding-block-end: 200px;
		background-image:
			linear-gradient(var(--overlay-color), var(--overlay-color)),
			url("/images/tests-section-cover.webp");
		background-size: cover;

		&.container {
			--container-width: 800px;
		}
	}

	@media screen and (width < 768px) {
		padding-block-end: 100px;
	}
}

.tests__list {
	list-style: none;
	display: flex;
	flex-direction: column;
	gap: 24px;
	padding: 0;
	margin: 0;
}

.test-link__title {
	margin: 0;
	font-size: 40px;
	line-height: 50px;
	font-weight: 500;

	@media screen and (width < 1500px) {
		font-size: 30px;
		line-height: 40px;
	}
}
</style>

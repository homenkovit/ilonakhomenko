---
import { faqItems } from "../../data/faq";

interface Props {
	titleTag?: "h1" | "h2";
}

const { titleTag: TitleTag = "h2" } = Astro.props;
---

<section class="faq container">
	<TitleTag class="page-subtitle">Популярные вопросы (FAQ)</TitleTag>
	{faqItems.map((item) => (
        <details class="faq__item">
            <summary><h3>{item.question}</h3></summary>
            <p set:html={item.answer}></p>
        </details>
    ))}
</section>

<script
	type="application/ld+json"
	set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer.replace(/<[^>]*>/g, ""),
        },
    })),
})}
></script>

<style>
.faq {
	background-color: #ddc0e3;

	&.container {
		--container-width: 1018px;

		@media screen and (width < 1500px) {
			--container-width: 704px;
		}
	}
}

.faq__item {
	padding-block: 40px;
	border-bottom: 1px solid var(--accent-color);

	&:first-of-type {
		padding-block-start: 0;
	}

	summary {
		list-style: none;
		display: flex;
		align-items: flex-start;
		gap: 16px;
		cursor: pointer;

		&::before {
			content: "?";
			flex-shrink: 0;
			display: grid;
			place-items: center;
			width: 40px;
			height: 40px;
			background-color: var(--accent-color);
			border-radius: 50%;
			font-size: 28px;
			color: #ddc0e3;
			transform: translateY(-2px);
		}

		&::after {
			content: "+";
			flex-shrink: 0;
			margin-inline-start: auto;
			font-size: 28px;
			font-weight: 200;
			color: var(--accent-color);

			@media (prefers-reduced-motion: no-preference) {
				transition: transform 0.2s ease;
			}
		}
	}

	&[open] summary::after {
		transform: rotate(45deg);
	}

	h3 {
		margin-block: 0;
		padding-block: 0;
		font-size: 24px;
		line-height: 34px;
		color: var(--accent-color);
	}

	p {
		padding-block-start: 24px;
		padding-inline-start: 54px;
		margin-block: 0;
		font-size: 20px;
		line-height: 30px;
	}

	@media screen and (width < 768px) {
		padding-block: 28px;
	}
}
</style>

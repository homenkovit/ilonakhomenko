---
import { pwaInfo } from "virtual:pwa-info";
import Footer from "../components/shared/Footer.astro";
import Header from "../components/shared/Header.astro";
import JsonLd from "../components/shared/JsonLd.astro";
import SEO from "../components/shared/SEO.astro";

import "../styles/global.css";
import AppointmentDialog from "../components/shared/AppointmentDialog.astro";
import type { Lang } from "../i18n/utils";
import { getLocalizedPath, useTranslations } from "../i18n/utils";

interface ArticleJsonLd {
	title: string;
	description: string;
	datePublished: string;
	url: string;
}

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: "website" | "article";
	articlePublishedTime?: string;
	jsonLdType?: "ProfessionalService" | "Article" | "WebPage";
	articleJsonLd?: ArticleJsonLd;
	breadcrumbs?: BreadcrumbItem[];
	class?: string;
	bodyBgColor?: string;
	lang: Lang;
}

const {
	title: subtitle,
	description,
	ogImage,
	ogType = "website",
	articlePublishedTime,
	jsonLdType = "WebPage",
	articleJsonLd,
	breadcrumbs,
	class: className,
	bodyBgColor,
	lang,
} = Astro.props;

const t = useTranslations(lang);
const siteTitle = t("site.title");
const title = `${siteTitle}${subtitle ? ` - ${subtitle}` : ""}`;
const canonicalUrl = Astro.url.pathname;

const defaultDescription = t("site.defaultDescription");
const finalDescription = description || defaultDescription;

const siteUrl = import.meta.env.SITE;
const altLang: Lang = lang === "ru" ? "en" : "ru";
const altPath = getLocalizedPath(Astro.url.pathname, altLang);
const currentPath = getLocalizedPath(Astro.url.pathname, lang);
const ruPath = lang === "ru" ? currentPath : altPath;
const enPath = lang === "en" ? currentPath : altPath;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8">
		<script is:inline>
		(() => {
			const saved = localStorage.getItem("theme");
			if (saved === "dark" || saved === "light") {
				document.documentElement.setAttribute("data-theme", saved);
				document.documentElement.style.colorScheme = saved;
			} else {
				document.documentElement.removeAttribute("data-theme");
				document.documentElement.style.colorScheme = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches
					? "dark"
					: "light";
			}
			const active = saved === "dark" || saved === "light" ? saved : "auto";
			document.querySelectorAll(".theme-switcher button").forEach((btn) => {
				btn.setAttribute(
					"aria-checked",
					btn.getAttribute("data-theme-value") === active ? "true" : "false",
				);
			});
		})();
		</script>

		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="theme-color" content="#3a2c44">

		<link
			rel="preload"
			href="/fonts/inter-latin-400-normal.woff2"
			crossorigin
			as="font"
			type="font/woff2"
		>
		<link
			rel="preload"
			href="/fonts/inter-latin-600-normal.woff2"
			crossorigin
			as="font"
			type="font/woff2"
		>
		{lang === "ru" && <>
		<link
			rel="preload"
			href="/fonts/inter-cyrillic-400-normal.woff2"
			crossorigin
			as="font"
			type="font/woff2"
		>
		<link
			rel="preload"
			href="/fonts/inter-cyrillic-600-normal.woff2"
			crossorigin
			as="font"
			type="font/woff2"
		>
		</>}

		<link rel="icon" href="/favicon.ico" sizes="32x32">
		<link rel="icon" href="/favicon.svg" type="image/svg+xml">
		<link rel="apple-touch-icon" href="/apple-touch-favicon.png">
		{lang === "en"
			? <link rel="manifest" href="/manifest-en.webmanifest" />
			: pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

		<link rel="alternate" hreflang="ru" href={new URL(ruPath, siteUrl).href}>
		<link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).href}>
		<link rel="alternate" hreflang="x-default" href={new URL(ruPath, siteUrl).href}>

		<title>{title}</title>
		<SEO
			title={title}
			description={finalDescription}
			canonicalUrl={canonicalUrl}
			ogImage={ogImage}
			ogType={ogType}
			articlePublishedTime={articlePublishedTime}
			lang={lang}
		/>

		<JsonLd type={jsonLdType} articleData={articleJsonLd} breadcrumbs={breadcrumbs} lang={lang} />
		<script>
		import "../scripts/pwa";
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">{t("skip.link")}</a>
		<Header lang={lang} />
		<main id="main-content" class={className}>
			<slot />
		</main>
		<Footer lang={lang} />
		<AppointmentDialog lang={lang} />
	</body>
</html>

<style is:global define:vars={{ bodyBgColor }}>
body {
	display: grid;
	grid-template-areas:
		"header"
		"main"
		"footer";
	grid-template-rows: auto 1fr auto;
	min-height: 100vh;
}

header {
	grid-area: header;
}

main {
	grid-area: main;
	overflow: hidden;
	margin-top: var(--header-height);
	padding-block: 160px;
	background-color: var(--bodyBgColor, var(--bg-color));

	@media screen and (width < 1500px) {
		padding-block: 100px;
	}

	@media screen and (width < 768px) {
		padding-block-start: 60px;
	}
}

footer {
	grid-area: footer;
}

.skip-link {
	z-index: 100;
	position: absolute;
	top: -100%;
	left: 16px;
	padding: 12px 24px;
	border-radius: 0 0 8px 8px;
	background-color: var(--text-color);
	font-size: 16px;
	text-decoration: none;

	&,
	&:visited {
		color: var(--bg-color);
	}

	&:focus {
		top: 0;
	}
}
</style>

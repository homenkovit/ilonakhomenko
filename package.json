{
	"name": "ilonakhomenko",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "astro dev --host",
		"build": "npm run check:i18n && astro build",
		"postbuild": "node scripts/generate-en-manifest.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"check:types": "astro check",
		"check:i18n": "node scripts/check-i18n-parity.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.0",
		"@vite-pwa/astro": "^1.2.0",
		"astro": "^5.17.2",
		"netlify-plugin-csp-generator": "^1.6.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.8",
		"@biomejs/biome": "2.3.15",
		"simple-git-hooks": "^2.11.1",
		"workbox-precaching": "^7.4.0"
	},
	"simple-git-hooks": {
		"pre-commit": "npm run lint && npm run check:types"
	}
}
